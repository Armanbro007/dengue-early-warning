# Copy to .env and fill in only what you need. The app runs fine with NO keys.

# Optional: Google Gemini key for the AI officer briefing (template fallback is used if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard cap on LLM calls per day (cost control)
LLM_DAILY_CALL_BUDGET=50

# Optional: set to 0 to disable all network calls (offline mode)
ALLOW_NETWORK=1
